.venv/
__pycache__/
*.py[cod]
.env
.env.*
!.env.example
# data/* not data/, because git does not descend into an excluded directory,
# so a negation inside one never applies. The previous `data/` left
# labels_corrected.csv and data/labels/equal_ground/ silently untracked.
data/*
!data/labels/
*.gpkg
*.osm.pbf
*.parquet
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/

# Pipeline data: lives here so the code can find it, but all of it re-downloads
# or recomputes. Only labels.csv and plat_judgement/ are tracked.
data/raw/
data/derived/
data/artifacts/
tests/fixture/derived/place_context.json
tests/fixture/derived/street_*.json
