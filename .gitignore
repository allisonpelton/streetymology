.venv/
__pycache__/
*.py[cod]
.env
.env.*
!.env.example
# data/* not data/, because git does not descend into an excluded directory,
# so a negation inside one never applies. The previous `data/` left
# labels_corrected.csv and data/labels/equal_ground/ silently untracked.
data/*
!data/labels/
*.gpkg
*.osm.pbf
*.parquet
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/
